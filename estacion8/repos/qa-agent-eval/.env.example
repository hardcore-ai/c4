# Copia este archivo a .env y completa los valores reales.
# Nunca commitees el .env con tu llave verdadera.

# Llave de OpenAI — requerida por Persona, Juez y el agente LLM bajo prueba.
# Obtener en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Endpoint del agente bajo prueba (opcional, default apunta al agente estatico local).
# Para evaluar el agente LLM local: http://localhost:3000/api/agent/llm
# Para evaluar un agente propio: https://tu-agente.com/api/chat
# AGENT_URL=http://localhost:3000/api/agent/chat

# Numero de turnos por conversacion (opcional, default 6).
# TURNOS=4
