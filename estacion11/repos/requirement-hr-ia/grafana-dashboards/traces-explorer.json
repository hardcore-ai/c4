    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Logs de la app que contienen el Session Trace ID. Cada línea trae trace_id y span_id como campos: clic en 'Ver trace en Tempo' salta a la traza.",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 53 },
      "id": 4,
      "title": "Logs de la sesion: $session_trace_id",
      "type": "logs",
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service_name=\"hr-ia-webapp\"} |= `${session_trace_id}`",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Logs que mencionan el email del usuario (login, sesión, acciones).",
