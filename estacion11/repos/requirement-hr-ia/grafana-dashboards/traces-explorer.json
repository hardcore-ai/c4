    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Recorrido del usuario en orden cronológico. Filtra por el campo log_service (structured metadata que inyecta el logger de la app).",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 78 },
      "id": 6,
      "title": "User journey (navegacion + auth)",
      "type": "logs",
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Ascending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service_name=\"hr-ia-webapp\"} |= `${session_trace_id}` | log_service =~ `sidebar|header|login-page|campaigns-page|campaign-detail|review-queue|candidate-review|new-campaign|session|auth`",
          "refId": "A"
        }
      ]
